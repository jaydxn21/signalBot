{
  "name": "nexus-signal-bot",
  "version": "1.5.0",
  "description": "NEXUS Algorithmic Trading Terminal",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file=.env server.js",
    "dev": "node --watch server.js",
    "engine": "node engine/engine.js",
    "cli": "node engine/cli.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:logs": "pm2 logs",
    "migrate": "node scripts/migrate-to-supabase.js",
    "seed:user": "node scripts/seed-users.js",
    "dashboard": "serve public/",
    "test:signals": "node scripts/test-signals.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "firebase-admin": "^13.10.0",
    "pg": "^8.11.3",
    "ws": "^8.21.1"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "private": true
}
