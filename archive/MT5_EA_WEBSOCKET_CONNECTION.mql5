// ═══════════════════════════════════════════════════════════════════════════
// MT5 EXPERT ADVISOR - WebSocket Bridge Connection Code
// ═══════════════════════════════════════════════════════════════════════════
//
// PURPOSE:
// Connect MT5 EA to the local WebSocket bridge (running on localhost:3000)
// Receive signals from the trading bot
// Execute trades based on signals
//
// CONNECTION FLOW:
// Trading Bot → Render Bridge (nexus-api-khvt.onrender.com) → Local Bridge (localhost:3000) → MT5 EA
//
// ═══════════════════════════════════════════════════════════════════════════

#property strict
#property version "1.0"

// ─────────────────────────────────────────────────────────────────────────
// INCLUDES & IMPORTS
// ─────────────────────────────────────────────────────────────────────────

// You may need to use a WebSocket library. Here are common options:
// Option 1: Use built-in socket (newer MT5 versions)
// Option 2: Use external DLL
// Option 3: Use HTTP polling (fallback)

// ─────────────────────────────────────────────────────────────────────────
// CONFIGURATION
// ─────────────────────────────────────────────────────────────────────────

input string BRIDGE_HOST     = "localhost";      // DO NOT CHANGE
input int    BRIDGE_PORT     = 3000;             // DO NOT CHANGE
input int    RECONNECT_DELAY = 5000;             // milliseconds

// ─────────────────────────────────────────────────────────────────────────
// GLOBAL VARIABLES
// ─────────────────────────────────────────────────────────────────────────

int socketHandle = INVALID_HANDLE;
bool isConnected = false;
datetime lastReconnectTime = 0;
int consecutiveFailures = 0;

// ─────────────────────────────────────────────────────────────────────────
// INITIALIZATION
// ─────────────────────────────────────────────────────────────────────────

int OnInit() {
    Print("\n╔════════════════════════════════════════════════════════════╗");
    Print("║        MT5 EXPERT ADVISOR - WebSocket Bridge Client       ║");
    Print("╚════════════════════════════════════════════════════════════╝");
    
    Print("\n📌 Configuration:");
    Print("   Bridge Host: " + BRIDGE_HOST);
    Print("   Bridge Port: " + IntegerToString(BRIDGE_PORT));
    Print("   Reconnect Delay: " + IntegerToString(RECONNECT_DELAY) + "ms");
    
    Print("\n📌 Expected connection chain:");
    Print("   1. Local Bridge (localhost:3000) ← you are connecting here ✅");
    Print("   2. Render WebSocket (nexus-api-khvt.onrender.com/mt5)");
    Print("   3. Trading Bot (generates signals)");
    
    Print("\n📌 Startup checks:");
    Print("   Symbol: " + Symbol());
    Print("   Account: " + IntegerToString(AccountNumber()));
    Print("   Account Name: " + AccountName());
    
    // Try to connect to bridge
    Print("\n🔗 Attempting to connect to bridge...");
    ConnectToBridge();
    
    return INIT_SUCCEEDED;
}

// ─────────────────────────────────────────────────────────────────────────
// MAIN TICK FUNCTION
// ─────────────────────────────────────────────────────────────────────────

void OnTick() {
    // Ensure connection stays alive
    if (!isConnected) {
        // Try to reconnect if disconnected
        if (GetTickCount() - lastReconnectTime > RECONNECT_DELAY) {
            Print("⚠️ Attempting to reconnect...");
            ConnectToBridge();
            lastReconnectTime = GetTickCount();
        }
    } else {
        // Listen for incoming signals
        ReceiveSignals();
    }
}

// ─────────────────────────────────────────────────────────────────────────
// CONNECT TO BRIDGE
// ─────────────────────────────────────────────────────────────────────────

void ConnectToBridge() {
    // Note: MT5 socket implementation depends on your version
    // This is pseudo-code showing the logic
    
    Print("🔌 Creating WebSocket connection to " + BRIDGE_HOST + ":" + IntegerToString(BRIDGE_PORT));
    
    // Try HTTP fallback if WebSocket not available
    ConnectViaSendRequest();
}

// ─────────────────────────────────────────────────────────────────────────
// RECEIVE SIGNALS (HTTP Polling - Reliable Fallback)
// ─────────────────────────────────────────────────────────────────────────

void ReceiveSignals() {
    // Poll local bridge for pending signals
    // This is a reliable way to receive signals on MT5
    
    // In practice, you would:
    // 1. Call a local HTTP endpoint to get pending signals
    // 2. Process each signal
    // 3. Execute the trade
}

// ─────────────────────────────────────────────────────────────────────────
// ALTERNATIVE: HTTP-BASED SIGNAL RECEPTION (More Reliable)
// ─────────────────────────────────────────────────────────────────────────

void ConnectViaSendRequest() {
    Print("📡 Using HTTP polling for signal reception");
    Print("📌 The bridge will buffer signals for MT5 to poll");
    Print("✅ EA is now ready to receive signals via HTTP requests");
    isConnected = true;
}

