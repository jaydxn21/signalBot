// ═══════════════════════════════════════════════════════════════════════════
// SIGNAL PROCESSING (Universal - Works with Any Connection Method)
// ═══════════════════════════════════════════════════════════════════════════

struct SignalData {
    string action;      // "buy" or "sell"
    string symbol;      // "Jump 75 Index"
    double price;       // entry price
    double sl;          // stop loss
    double tp;          // take profit
    double volume;      // lot size
    string timestamp;   // when signal was generated
};

bool ParseSignal(string jsonMessage, SignalData& signal) {
    Print("🔍 Parsing signal: " + jsonMessage);
    
    // Simple JSON parsing (you may need a JSON library)
    // Example signal format:
    // {"action":"buy","symbol":"Jump 75 Index","price":16912.9,"sl":16880,"tp":16972,"volume":0.1}
    
    // Check if it contains our required fields
    if (StringFind(jsonMessage, "action") == -1) {
        Print("❌ Invalid signal format (missing 'action')");
        return false;
    }
    
    // Extract values (simplified - use JSON library for production)
    signal.action = "buy";  // TODO: Extract from JSON
    signal.symbol = Symbol();
    signal.price = Bid;
    signal.sl = Bid - 100 * Point();
    signal.tp = Bid + 150 * Point();
    signal.volume = 0.1;
    
    Print("✅ Signal parsed: " + signal.action + " " + signal.symbol);
    return true;
}

void ProcessSignal(string jsonMessage) {
    Print("\n╔════════════════════════════════════════════════════════════╗");
    Print("║               PROCESSING INCOMING SIGNAL                   ║");
    Print("╚════════════════════════════════════════════════════════════╝");
    
    SignalData signal;
    
    if (!ParseSignal(jsonMessage, signal)) {
        Print("❌ Failed to parse signal");
        return;
    }
    
    // Validate signal
    if (!ValidateSignal(signal)) {
        Print("❌ Signal validation failed");
        return;
    }
    
    // Execute trade
    ExecuteTrade(signal);
}

bool ValidateSignal(SignalData& signal) {
    Print("\n🔍 Validating signal...");
    
    // Check action
    if (signal.action != "buy" && signal.action != "sell") {
        Print("❌ Invalid action: " + signal.action);
        return false;
    }
    Print("   ✅ Action: " + signal.action);
    
    // Check price
    if (signal.price <= 0) {
        Print("❌ Invalid price: " + DoubleToString(signal.price));
        return false;
    }
    Print("   ✅ Price: " + DoubleToString(signal.price));
    
    // Check SL and TP
    if (signal.sl <= 0 || signal.tp <= 0) {
        Print("❌ Invalid SL/TP");
        return false;
    }
    Print("   ✅ SL: " + DoubleToString(signal.sl) + " | TP: " + DoubleToString(signal.tp));
    
    // Check volume
    if (signal.volume <= 0) {
        Print("❌ Invalid volume: " + DoubleToString(signal.volume));
        return false;
    }
    Print("   ✅ Volume: " + DoubleToString(signal.volume));
    
    Print("\n✅ Signal validation passed!");
    return true;
}

void ExecuteTrade(SignalData& signal) {
    Print("\n╔════════════════════════════════════════════════════════════╗");
    Print("║                   EXECUTING TRADE                         ║");
    Print("╚════════════════════════════════════════════════════════════╝");
    
    // Close existing position if any
    CloseExistingPositions();
    
    // Prepare order
    MqlTradeRequest request = {};
    MqlTradeResult result = {};
    
    request.action = TRADE_ACTION_DEAL;
    request.symbol = Symbol();
    request.volume = signal.volume;
    request.type = (signal.action == "buy") ? ORDER_TYPE_BUY : ORDER_TYPE_SELL;
    request.price = (signal.action == "buy") ? Ask : Bid;
    request.sl = signal.sl;
    request.tp = signal.tp;
    request.comment = "Bot Signal: " + signal.action;
    request.magic = 987654;  // Your EA magic number
    
    Print("\n📋 Order details:");
    Print("   Symbol: " + request.symbol);
    Print("   Type: " + (signal.action == "buy" ? "BUY" : "SELL"));
    Print("   Volume: " + DoubleToString(request.volume));
    Print("   Price: " + DoubleToString(request.price));
    Print("   SL: " + DoubleToString(request.sl));
    Print("   TP: " + DoubleToString(request.tp));
    
    // Send order
    Print("\n🚀 Sending order to MT5...");
    if (!OrderSend(request, result)) {
        Print("❌ Order failed!");
        Print("   Error code: " + IntegerToString(result.retcode));
        Print("   Comment: " + result.comment);
        return;
    }
    
    // Success
    Print("✅ ORDER EXECUTED!");
    Print("   Ticket: " + IntegerToString(result.order));
    Print("   Comment: " + result.comment);
    Print("   Volume: " + DoubleToString(result.volume));
}

void CloseExistingPositions() {
    // Close all open positions for this symbol
    for (int i = PositionsTotal() - 1; i >= 0; i--) {
        ulong ticket = PositionGetTicket(i);
        if (PositionSelectByTicket(ticket)) {
            if (PositionGetString(POSITION_SYMBOL) == Symbol()) {
                Print("🔄 Closing existing position: " + IntegerToString(ticket));
                
                MqlTradeRequest request = {};
                MqlTradeResult result = {};
                
                request.action = TRADE_ACTION_DEAL;
                request.symbol = Symbol();
                request.volume = PositionGetDouble(POSITION_VOLUME);
                request.type = (PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_BUY) ? 
                               ORDER_TYPE_SELL : ORDER_TYPE_BUY;
                request.position = ticket;
                
                OrderSend(request, result);
            }
        }
    }
}

void OnDeinit(const int reason) {
    Print("\n❌ EA stopped");
    isConnected = false;
}

// ═══════════════════════════════════════════════════════════════════════════
// QUICK SETUP GUIDE FOR YOUR MT5
// ═══════════════════════════════════════════════════════════════════════════

/*

STEP 1: Verify Bridge is Running
─────────────────────────────────
Your bridge output should show:
  ✅ Local WS server listening on ws://localhost:3000
  ✅ Connected to Render WebSocket
  
If not, check your bridge.cjs file is correct (see the bridge code below)

STEP 2: Add This Code to Your MT5 EA
─────────────────────────────────────
Copy the functions above into your EA's OnInit() and OnTick()

STEP 3: Compile in MT5
──────────────────────
1. Open your EA in MetaEditor
2. Paste this code
3. Compile (F5)
4. Attach to Jump 75 Index chart
5. Enable "Allow WebSocket" in settings

STEP 4: Monitor the Logs
────────────────────────
In MT5 Terminal → Experts tab, watch for:
  ✅ "Connected to bridge"
  ✅ "Signal received from bot"
  ✅ "Order executed successfully"

STEP 5: Test from Browser
──────────────────────────
1. Open browser console
2. Run: window._mt5Debug?.testSignal()
3. Watch MT5 logs for incoming signal
4. Should execute trade ✅

*/
